Identifier = "nkUI"
Name = "Naifu's UI Suite"
NameShort ="nkUI"
Description = "Naifu's user interface"

Author = "Naifu"
Email = "naifukishi@gmail.com"

Version = "0.2.2"
Environment = "4.0"

RunOnStartup = {
	"main.lua",
	"tools.lua",
	"locales/localizationEN.lua",
	"locales/localizationDE.lua",

	"modules/lowerbar/lowerbar.lua",

	"modules/onebag/onebag.lua",

	"modules/unitFrames/events.lua",
	"modules/unitFrames/statevents.lua",
	"modules/unitFrames/buffBar.lua",
	"modules/unitFrames/buffManagement.lua",
	"modules/unitFrames/iconManagement.lua",
	"modules/unitFrames/uiframes.lua",
	"modules/unitFrames/castbar.lua",
	"modules/unitFrames/buffIcon.lua",
	"modules/unitFrames/ressourceBar.lua",

	"modules/sct/scrollingCombatText.lua",

	"modules/tooltip/tooltip.lua",

	"settings/settings.lua",

	"modules/actionbar/actionbar.lua",
	"modules/actionbar/actionicon.lua",
	"modules/actionbar/events.lua",
	"modules/actionbar/macroEditDialog.lua",
}

Embed = {	
  ["Libs/EnKai"] = true,
}

Dependencies = {
  EnKai = {"required", "before"},
}

SavedVariables = {
   nkUISetup	 	   = "account"
}

